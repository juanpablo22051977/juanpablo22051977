# Microsoft Fabric / OneLake Configuration
# Copia este archivo a .env y completa con tus credenciales reales

# Azure AD / Entra ID Credentials
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# Microsoft Fabric Workspace
FABRIC_WORKSPACE_ID=your-workspace-id-here
FABRIC_WORKSPACE_NAME=your-workspace-name

# OneLake Configuration
ONELAKE_ENDPOINT=https://onelake.dfs.fabric.microsoft.com
ONELAKE_ACCOUNT_NAME=your-onelake-account

# Lakehouse Configuration
LAKEHOUSE_NAME=your-lakehouse-name
LAKEHOUSE_ID=your-lakehouse-id

# Storage Paths
ONELAKE_BASE_PATH=/Files
LOCAL_DATA_PATH=./fabric/data

# Optional: Power BI Configuration
POWERBI_GROUP_ID=your-powerbi-group-id
POWERBI_DATASET_ID=your-powerbi-dataset-id
