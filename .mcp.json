{
  "mcpServers": {
    "powerbi": {
      "type": "stdio",
      "command": "python",
      "args": ["mcp/powerbi_server.py"],
      "env": {
        "AZURE_TENANT_ID": "${AZURE_TENANT_ID}",
        "AZURE_CLIENT_ID": "${AZURE_CLIENT_ID}",
        "AZURE_CLIENT_SECRET": "${AZURE_CLIENT_SECRET}",
        "FABRIC_WORKSPACE_ID": "${FABRIC_WORKSPACE_ID}"
      }
    }
  }
}
